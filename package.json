{
  "name": "pdf-kha-do",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-notices.mjs && node scripts/seo.mjs && node scripts/report-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:pdf:native": "python3 scripts/native-smoke.py",
    "predev": "node scripts/vendor-engine.mjs",
    "prebuild": "node scripts/vendor-engine.mjs",
    "test:corpus": "node scripts/make-corpus.mjs && playwright test -c playwright.corpus.config.ts",
    "dev:pdf-to-md": "node scripts/vendor-engine.mjs && vite --config experiments/pdf-to-md/vite.config.ts --host 127.0.0.1 --port 4182 --strictPort",
    "test:pdf-to-md": "vitest run tests/markdown.test.ts tests/markdown-preview.test.ts && playwright test --config experiments/pdf-to-md/playwright.config.ts"
  },
  "dependencies": {
    "@wasm-zoo/ghostscript": "0.7.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
